{
  "services": {
    "gateway": {
      "name": "gateway",
      "type": "service",
      "port": 8080,
      "health_endpoint": "http://127.0.0.1:8080/health",
      "metrics_endpoint": "http://127.0.0.1:8080/metrics",
      "dependencies": [
        "orders"
      ]
    },
    "orders": {
      "name": "orders",
      "type": "service",
      "port": 8081,
      "health_endpoint": "http://127.0.0.1:8081/health",
      "metrics_endpoint": "http://127.0.0.1:8081/metrics",
      "dependencies": [
        "payments",
        "postgres"
      ]
    },
    "payments": {
      "name": "payments",
      "type": "service",
      "port": 8082,
      "health_endpoint": "http://127.0.0.1:8082/health",
      "metrics_endpoint": "http://127.0.0.1:8082/metrics",
      "dependencies": []
    },
    "postgres": {
      "name": "postgres",
      "type": "database",
      "port": 5432,
      "dependencies": []
    },
    "prometheus": {
      "name": "prometheus",
      "type": "telemetry",
      "port": 9090,
      "dependencies": [
        "gateway",
        "orders",
        "payments"
      ]
    }
  },
  "edges": [
    {
      "source": "gateway",
      "target": "orders"
    },
    {
      "source": "orders",
      "target": "payments"
    },
    {
      "source": "orders",
      "target": "postgres"
    },
    {
      "source": "prometheus",
      "target": "gateway"
    },
    {
      "source": "prometheus",
      "target": "orders"
    },
    {
      "source": "prometheus",
      "target": "payments"
    }
  ]
}