# ==============================================================================
# NightShift - AI On-Call Engineer: Environment Configuration Template
# Section 5, Rule 5: Secrets only in .env (git-ignored); commit .env.example
# ==============================================================================

# LLM API (Anthropic / Claude Sonnet-class model)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_SPEND_CAP_USD=50.00

# Target System Services
GATEWAY_PORT=8080
ORDERS_PORT=8081
PAYMENTS_PORT=8082
INVENTORY_PORT=8083
PROMETHEUS_PORT=9090

# Target System Database (PostgreSQL)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_this_in_local_env
POSTGRES_DB=target_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Platform API (FastAPI)
PLATFORM_API_HOST=0.0.0.0
PLATFORM_API_PORT=8000
PLATFORM_API_BASE_URL=http://localhost:8000

# Safety Guardrails and Confidence Thresholds (Section 6 & 7)
SAFETY_KILL_SWITCH=false
CONFIDENCE_THRESHOLD_T1=0.80
CONFIDENCE_THRESHOLD_T2=0.85
MAX_TOOL_CALLS_BUDGET=15
ACTION_COOLDOWN_MINUTES=10

# Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
GITHUB_TOKEN=ghp_your_github_sandbox_token
GITHUB_SANDBOX_REPO=nightshift/target-app-sandbox
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/nightshift-events
N8N_API_KEY=your-n8n-api-key-here
OLOSTEP_API_KEY=your-olostep-api-key-here

# Persistent Storage & Memory
SQLITE_DB_PATH=data/nightshift.db
BENCHMARK_RESULTS_PATH=results/results.json
