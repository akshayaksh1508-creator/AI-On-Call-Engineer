{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "type", "diff", "risk_tier", "rationale", "expected_metric_effect", "regression_test", "evidence_ids"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["patch", "rollback", "config"]},
    "diff": {"type": "string"},
    "risk_tier": {"enum": ["T1", "T2", "T3"]},
    "rationale": {"type": "string", "minLength": 1},
    "expected_metric_effect": {"type": "string", "minLength": 1},
    "regression_test": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "fault_id": {"type": ["string", "null"]},
    "branch_name": {"type": ["string", "null"]}
  }
}
